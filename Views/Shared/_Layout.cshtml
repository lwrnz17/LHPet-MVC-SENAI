<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - LH-Pet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="border-bottom bg-white">
        <nav class="navbar navbar-expand-lg container py-3">
            <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">LH-Pet</a>
            <span class="text-secondary small">Controle interno</span>
        </nav>
    </header>
    <main class="container py-4">@RenderBody()</main>
    <footer class="container py-3 border-top text-secondary small">LH-Pet · Projeto acadêmico MVC</footer>
</body>
</html>
